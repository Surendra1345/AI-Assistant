# Copy to .env and fill in. Get a key at https://console.anthropic.com
# Optional:
ANTHROPIC_API_KEY=
# Free key at https://console.groq.com  (used as the main brain if there's no Anthropic key)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# BRAIN_ORDER=claude,groq,ollama     # tried in this order; skipped if not configured

# Your own address, so "mail me the result" works:
USER_EMAIL=

# Optional tweaks (defaults shown)
# ASSISTANT_MODEL=claude-sonnet-5-5
# WAKE_MODE=wakeword          # or "enter" = press Enter to talk (good first test)
# WAKE_WORD=hey_jarvis
# WHISPER_MODEL=base.en       # small.en = more accurate, slower
# USER_TITLE=sir            # how Jarvis addresses you ("sir", or your first name)
# ASSISTANT_NAME=Jarvis
# FOLLOWUP_SECONDS=-1       # conversation stays open this long after it speaks; -1 = auto (35 speakers / 45 earbuds), 0 = wake word every time
# ACK_SPOKEN=1              # say "Searching now." before slow work
# PAUSE_SECONDS=1.6          # silence that ends your request; raise further if it still cuts you off mid-sentence
# MAX_REQUEST_SECONDS=30     # longest single request
# MAX_BG_WORKERS=2
# AUTO_APPROVE_TOOLS=         # e.g. organize_apply  (skips the yes/no prompt for that tool)
# OLLAMA_MODEL=llama3.2:3b    # local brain (with tools)
# INPUT_DEVICE=auto        # "auto" = built-in MacBook mic; or part of a device name

# Voice: pick one engine
# TTS_ENGINE=piper          # default: natural offline voice (downloaded by setup.sh)
# TTS_ENGINE=say            # macOS built-in voices
# TTS_VOICE=Samantha        # default US English
# TTS_VOICE=Rishi           # Indian English - download it first in System Settings > Accessibility >
                             # Spoken Content > System Voice, then set TTS_ENGINE=say and this
# TTS_ENGINE=elevenlabs     # most natural, needs an API key (free tier: 10,000 chars/month)
# ELEVENLABS_API_KEY=       # get one at https://elevenlabs.io - defaults to "Vikram" (Indian English)
# TTS_RATE=170              # words per minute for the "say" engine; lower = slower, more deliberate
